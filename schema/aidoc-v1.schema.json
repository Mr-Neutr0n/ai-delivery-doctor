{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Yazhou-Li/ai-delivery-doctor/blob/main/schema/aidoc-v1.schema.json",
  "title": "AI Delivery Doctor Contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "name",
    "checks"
  ],
  "properties": {
    "schema": {
      "const": "aidoc-v1"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "stage",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "stage": {
            "type": "string",
            "minLength": 1
          },
          "type": {
            "enum": [
              "directory",
              "file",
              "env",
              "executable",
              "tcp",
              "http",
              "openai-compatible"
            ]
          },
          "required": {
            "type": "boolean"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "timeout": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "accept_status": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "integer",
              "minimum": 100,
              "maximum": 599
            }
          },
          "base_url": {
            "type": "string",
            "minLength": 1
          },
          "api_key_env": {
            "type": "string",
            "minLength": 1
          },
          "model": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
